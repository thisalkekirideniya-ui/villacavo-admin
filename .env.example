# Copy to .env.local for local development (optional), and set the same
# values in Vercel → admin project → Settings → Environment Variables.

# Password for signing in to the admin (required on Vercel; locally defaults to "admin").
ADMIN_PASSWORD=

# Address of the public website, used by the Preview button.
# Locally it defaults to http://localhost:5173
VITE_SITE_URL=https://your-website.vercel.app

# Added automatically when you connect a Vercel Blob store to the admin project.
# BLOB_READ_WRITE_TOKEN=

# Optional: store uploaded photos in Cloudinary instead of Vercel Blob.
# Cloudinary → Dashboard (Programmable Media) → "API Environment variable".
# Paste it as one line, e.g. cloudinary://123456789012345:abcdefSECRET@your-cloud-name
# CLOUDINARY_URL=
# Folder the photos go into (default: villa-cavo)
# CLOUDINARY_FOLDER=villa-cavo
